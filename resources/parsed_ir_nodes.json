    "constructors": [],
    "sourceText": "class UserRegistry {\r\n    // Private property restricted to this class\r\n    private users: User[] = [];\r\n\r\n    // Method with typed parameters and void return type\r\n    public addUser(newUser: User): void {\r\n        this.users.push(newUser);\r\n        console.log(`User ${newUser.name} added successfully.`);\r\n    }\r\n\r\n    // Method returning a specific User or undefined if not found\r\n    public findUserById(id: number): User | undefined {\r\n        return this.users.find(user => user.id === id);\r\n    }\r\n}"
